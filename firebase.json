{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".*",
      "**/node_modules/**",
      "**/PANDUAN-INSTALASI.txt"
    ],
    "headers": [
      {
        "source": "/service-worker.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}